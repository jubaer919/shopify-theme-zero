.hero-banner {
  position: relative;

  & .hero-image {
    background-size: cover;
    background-position: center;
    height: 80vh;
    min-height: 500px;
  }

  & .placeholder-background {
    background-color: #f5f5f5;
    height: 80vh;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  & .overlay {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    width: 100%;
  }

  & .hero-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    width: 80%;
    max-width: 800px;
  }

  & .heading {
    font-size: 3rem;
    margin-bottom: 1.25rem;
  }

  & .description {
    font-size: 1.25rem;
    margin-bottom: 2rem;
  }

  & .hero-button {
    color: white;
    padding: 12px 30px;
    border-radius: 4px;
    text-decoration: none;
    font-weight: bold;
    display: inline-block;
  }
}
