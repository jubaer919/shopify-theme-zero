.cart-drawer {
  position: fixed;
  top: 0;
  right: -400px;
  width: 400px;
  height: 100%;
  padding: 20px;
  overflow-y: auto;
  background-color: white;
  box-shadow: -5px 0 15px rgba(0, 0, 0, 0.1);
  transition: right 0.3s ease;
  z-index: 9999;

  & .close-cart {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    font-size: 1.5rem;
    cursor: pointer;
  }

  & .cart-heading {
    margin-top: 40px;
  }

  & .cart-footer {
    margin-top: 20px;
    border-top: 1px slid #eee;
    padding-top: 20px;

    & .total {
      display: flex;
      justify-content: space-between;
      font-weight: bold;
      margin-bottom: 20px;
    }

    & .cart-checkout {
      display: block;
      background-color: #1e40af;
      color: white;
      text-align: center;
      padding: 12px;
      font-weight: bold;
      text-decoration: none;
      border-radius: 4px;
    }
  }
}

.cart-list {
  list-style: none;
  padding: 0;

  & .cart-item {
    display: flex;
    padding: 10px 0;
    border-bottom: 1px solid #f5f5f5;
  }

  & .cart-item__image-container {
    width: 70px;
    margin-right: 15px;
  }

  & .cart-item__image {
    max-width: 100%;
  }

  & .cart-item__description {
    flex: 1;

    & .cart-item__heading {
      font-weight: 600;
      margin-bottom: 10px;
    }

    & .cart-item_details {
      display: flex;
      align-items: center;
      margin-top: 5px;
    }

    & .cart-item__quantity {
      width: 50px;
      padding: 5px;
      margin-right: 10px;
    }

    & .cart-item__remove {
      background: none;
      border: none;
      color: #f00;
      margin-left: 10px;
      cursor: pointer;
    }
  }
}
