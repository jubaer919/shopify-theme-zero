.featured-product-section {
  & .section-heading {
    text-align: center;
    margin-bottom: 2rem;
  }

  & .layout-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1.25rem;
  }

  & .layout-flex {
    display: flex;
    overflow-x: auto;
    gap: 1rem;
    padding-bottom: 1.25rem;
  }

  & .product-card {
    border: 1px solid #eee;
    border-radius: 0.5rem;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  & .product-image-container {
    height: 250px;
    background: #f9f9f9;
    display: flex;
    align-items: center;
    justify-content: center;

    & .product-image {
      max-height: 100%;
      max-width: 100%;
    }
  }

  & .product-info {
    padding: 1rem;

    & .product-title {
      margin-bottom: 10px;
    }

    & .product-price {
      font-weight: bold;
    }

    & .product-compare-price {
      color: #999;
      text-decoration: line-through;
      font-size: 0.9em;
      margin-left: 5px;
    }
  }
}
